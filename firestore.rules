rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 檢查用戶是否已登入
    function isAuthenticated() {
      return request.auth != null;
    }

    // 檢查用戶是否為資料擁有者
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 驗證必要欄位存在
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validSharing(shared) {
      return shared is map
        && shared.keys().hasOnly(['血糖', '血糖數據', '血壓', '血壓數據',
          '用藥', '用藥記錄', '用藥數據', '健康分析', '分析數據'])
        && shared.get('血糖', false) is bool
        && shared.get('血糖數據', false) is bool
        && shared.get('血壓', false) is bool
        && shared.get('血壓數據', false) is bool
        && shared.get('用藥', false) is bool
        && shared.get('用藥記錄', false) is bool
        && shared.get('用藥數據', false) is bool
        && shared.get('健康分析', false) is bool
        && shared.get('分析數據', false) is bool;
    }

    function noSharing(shared) {
      return validSharing(shared)
        && shared.get('血糖', false) == false
        && shared.get('血糖數據', false) == false
        && shared.get('血壓', false) == false
        && shared.get('血壓數據', false) == false
        && shared.get('用藥', false) == false
        && shared.get('用藥記錄', false) == false
        && shared.get('用藥數據', false) == false
        && shared.get('健康分析', false) == false
        && shared.get('分析數據', false) == false;
    }

    function inviteRecipient(invite) {
      let email = request.auth.token.get('email', '').lower();
      return (invite.get('invitedToEmail', '') != ''
          && invite.invitedToEmail == email)
        || (invite.get('emailOrPhone', '') != ''
          && invite.emailOrPhone == email)
        || (!invite.keys().hasAny(['invitedToEmail', 'emailOrPhone'])
          && invite.get('inviteCode', '') != '');
    }

    function validFamily(owner, viewer) {
      let grantPath = /databases/$(database)/documents/users/$(owner)/family_members/$(viewer);
      let reversePath = /databases/$(database)/documents/users/$(viewer)/family_members/$(owner);
      let grant = get(grantPath).data;
      let invite = get(/databases/$(database)/documents/family_invites/$(grant.inviteId)).data;
      return exists(grantPath) && exists(reversePath)
        && grant.userId == viewer
        && invite.status == 'accepted'
        && ((invite.invitedBy == owner && invite.acceptedBy == viewer)
          || (invite.invitedBy == viewer && invite.acceptedBy == owner));
    }

    function familySharing(owner, kind) {
      let shared = get(/databases/$(database)/documents/users/$(owner)/family_members/$(request.auth.uid)).data.sharedData;
      return isAuthenticated() && validFamily(owner, request.auth.uid)
        && ((kind == '血糖' && (shared.get('血糖', false) || shared.get('血糖數據', false)))
          || (kind == '血壓' && (shared.get('血壓', false) || shared.get('血壓數據', false)))
          || (kind == '用藥' && (shared.get('用藥', false) || shared.get('用藥記錄', false) || shared.get('用藥數據', false))));
    }

    // Relationships may only be created while consuming a pending invitation.
    function invitedRelationship(owner, member) {
      let inviteId = request.resource.data.inviteId;
      let before = get(/databases/$(database)/documents/family_invites/$(inviteId)).data;
      let after = getAfter(/databases/$(database)/documents/family_invites/$(inviteId)).data;
      return isAuthenticated()
        && request.resource.data.userId == member && owner != member
        && before.status == 'pending' && before.expiresAt > request.time
        && after.status == 'accepted' && after.acceptedBy == request.auth.uid
        && ((before.invitedBy == owner && member == request.auth.uid
            && request.resource.data.sharedData == before.sharedData)
          || (owner == request.auth.uid && member == before.invitedBy
            && noSharing(request.resource.data.sharedData)))
        && existsAfter(/databases/$(database)/documents/users/$(member)/family_members/$(owner));
    }

    // 用戶資料 (users/{userId})
    match /users/{userId} {
      // 已登入用戶可讀取基本資料（接受家庭邀請時需要查詢對方的名字/email）
      // 健康相關子集合仍受各自規則保護
      allow read: if isAuthenticated();

      // 建立帳號時驗證必要欄位
      allow create: if isOwner(userId)
        && hasRequiredFields(['email', 'fullName', 'createdAt']);

      // 更新時不能修改 email 和 createdAt
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // 允許用戶刪除自己的帳號
      allow delete: if isOwner(userId);

      // 用藥紀錄 (users/{userId}/medicine)
      match /medicine/{medicineId} {
        allow read: if isOwner(userId) || familySharing(userId, '用藥');
        allow create: if isOwner(userId)
          && hasRequiredFields(['name', 'frequency', 'times_status']);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // 用藥日誌 (users/{userId}/medication_logs)
      match /medication_logs/{logId} {
        allow read: if isOwner(userId);
        // 只能新增，不能修改或刪除（保持紀錄完整性）
        allow create: if isOwner(userId)
          && hasRequiredFields(['medicine_id', 'intake_time', 'is_taken']);
        // 如果需要允許刪除，取消下面這行的註解
        // allow delete: if isOwner(userId);
      }

      // 健康紀錄 (users/{userId}/health_records)
      match /health_records/{recordId} {
        allow read: if isOwner(userId) || familySharing(userId, resource.data.category);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // 飲食紀錄 (users/{userId}/diet_records)
      match /diet_records/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
    
    // Invitation code possession authorizes redemption; targeted emails do not.
    match /family_invites/{inviteCode} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && !request.resource.data.keys().hasAny(['acceptedBy'])
        && validSharing(request.resource.data.sharedData);
      allow update: if isAuthenticated()
        && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && resource.data.invitedBy != request.auth.uid
        && inviteRecipient(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedBy', 'respondedAt'])
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.respondedAt == request.time
        && (request.resource.data.status in ['declined', 'rejected']
          || (request.resource.data.status == 'accepted'
            && existsAfter(/databases/$(database)/documents/users/$(resource.data.invitedBy)/family_members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/family_members/$(resource.data.invitedBy))));
      allow delete: if isAuthenticated()
        && resource.data.invitedBy == request.auth.uid
        && resource.data.status == 'pending';
    }

    match /users/{userId}/family_members/{memberId} {
      allow read: if isOwner(userId)
        || (isAuthenticated() && request.auth.uid == memberId);
      allow create: if invitedRelationship(userId, memberId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sharedData', 'name', 'relation', 'isOnline', 'avatarUrl'])
        && validSharing(request.resource.data.sharedData);
      allow delete: if isOwner(userId)
        || (isAuthenticated() && request.auth.uid == memberId);
    }

    // 聊天室 (chats/{chatId})
    match /chats/{chatId} {
      // 文件不存在時(resource==null)允許讀取，用於檢查聊天室是否存在
      // 文件存在時只有成員可以讀取
      allow read: if isAuthenticated()
        && (resource == null || request.auth.uid in resource.data.members);

      // 建立聊天室：建立者必須是成員之一
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members;

      // 更新（發訊息時更新 lastMessage / unread）：必須是成員
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      // 訊息子集合：聊天室成員才能讀寫
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
  }
}
