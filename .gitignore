# Environment variables - NEVER commit these!
.env
.env.local
.env.*.local
*.env

# Firebase configuration (may contain sensitive data)
google-services.json
GoogleService-Info.plist
firebase_options.dart

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local dependencies, tooling and signing credentials
node_modules/
.claude/
.github/java-upgrade/
.github/modernize/
*.jks
*.keystore
*.p12
*.p8
*.pem
key.properties

# Local AI development credentials (never bundle or commit)
.env.development.json
.secret.local
functions/.secret.local
